{
  "name": "chudpresence",
  "version": "2.1.3",
  "private": true,
  "type": "module",
  "description": "Share your browsing and playback activity on Discord with customizable Activities.",
  "license": "GPL-3.0-only",
  "scripts": {
    "check": "node scripts/check.mjs && node scripts/build-v2-engine.mjs --check",
    "test": "node --test test/*.test.js",
    "test:v2-browser": "node scripts/test-v2-browser.mjs",
    "test:foreground-browser": "node scripts/test-foreground-browser.mjs",
    "test:activities-browser": "node scripts/test-activities-browser.mjs",
    "test:jellyfin-browser": "node scripts/test-jellyfin-browser.mjs",
    "test:link-browser": "node scripts/test-link-browser.mjs",
    "build": "node scripts/build.mjs",
    "build:chromium": "node scripts/build.mjs chromium",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:firefox:production": "node scripts/build.mjs firefox-production",
    "build:all": "node scripts/build.mjs all",
    "check:packages": "node scripts/check-packages.mjs",
    "lint:firefox": "node scripts/lint-firefox.mjs",
    "lint:firefox:production": "node scripts/lint-firefox.mjs --production",
    "build:contracts": "node scripts/generate-v1-contract.mjs && node scripts/generate-v2-contract.mjs",
    "build:v2-engine": "node scripts/build-v2-engine.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "addons-linter": "10.14.0",
    "esbuild": "0.25.12",
    "quickjs-emscripten": "0.32.0"
  }
}
