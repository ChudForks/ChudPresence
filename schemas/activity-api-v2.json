{
  "schemaVersion": 1,
  "apiVersion": 2,
  "supportedApiVersions": [
    1,
    2
  ],
  "execution": "QuickJS in WebAssembly; package source is data, never native browser JavaScript",
  "limits": {
    "metadataBytes": 65536,
    "reportBytes": 16384,
    "sourceBytes": 524288,
    "iconBytes": 262144,
    "executionMs": 50,
    "memoryBytes": 16777216,
    "wasmMemoryBytes": 33554432,
    "stackBytes": 262144,
    "requestBytes": 65536,
    "resultBytes": 262144,
    "pendingRequests": 16,
    "requestsPerWindow": 30,
    "requestWindowMs": 10000,
    "pendingJobs": 256,
    "updateIntervalMs": 2000,
    "workerStartupMs": 5000,
    "workerExecutionMs": 2000,
    "workerInactivityMs": 120000,
    "workerSessions": 16
  },
  "metadataSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://chudpresence.local/schemas/activity-v2.schema.json",
    "title": "ChudPresence sandboxed Activity API v2 metadata",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "description",
      "version",
      "apiVersion",
      "matches",
      "entry"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "version": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
      },
      "apiVersion": {
        "const": 2
      },
      "minExtensionVersion": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
      },
      "author": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      },
      "contributors": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          }
        }
      },
      "category": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      },
      "defaultMediaKind": {
        "enum": [
          "video",
          "movie",
          "episode",
          "song",
          "stream",
          "game",
          "generic"
        ]
      },
      "aliases": {
        "type": "array",
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "tags": {
        "type": "array",
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
        }
      },
      "matches": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^https://[^/]+/.+$"
        }
      },
      "excludeMatches": {
        "type": "array",
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^https://[^/]+/.+$"
        }
      },
      "entry": {
        "const": "activity.js"
      },
      "icon": {
        "const": "icon.png"
      },
      "executionWorld": {
        "const": "USER_SCRIPT"
      },
      "frames": {
        "enum": [
          "top",
          "all"
        ]
      },
      "network": {
        "type": "array",
        "maxItems": 32,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^https://[^/]+/.+$"
        }
      },
      "settings": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "label",
                "default"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9_-]{0,63}$"
                },
                "type": {
                  "const": "boolean"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "default": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "label",
                "default",
                "options"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9_-]{0,63}$"
                },
                "type": {
                  "const": "select"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "default": {
                  "type": "string",
                  "maxLength": 128
                },
                "options": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "value"
                    ],
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "value": {
                        "type": "string",
                        "maxLength": 128
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "label",
                "default"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9_-]{0,63}$"
                },
                "type": {
                  "const": "string"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "default": {
                  "type": "string",
                  "maxLength": 256
                },
                "maxLength": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 256
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "label",
                "default",
                "min",
                "max"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9_-]{0,63}$"
                },
                "type": {
                  "enum": [
                    "number",
                    "range"
                  ]
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "default": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                },
                "step": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          ]
        }
      },
      "settingsUi": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "statusLabels": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "app": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "\\S"
              },
              "artist": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "\\S"
              },
              "track": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "\\S"
              }
            }
          }
        }
      },
      "repository": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "homepage": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "serviceUrl": {
        "type": "string",
        "format": "uri",
        "pattern": "^https://"
      },
      "presence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "music",
              "video",
              "streaming",
              "generic"
            ]
          },
          "navigationGraceMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5000,
            "default": 0,
            "description": "Bounded presence retention during navigation within this Activity. Tab close and explicit teardown bypass it."
          }
        }
      },
      "pageAccess": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "boolean",
            "default": false
          },
          "media": {
            "type": "boolean",
            "default": false
          },
          "queryParameters": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$",
              "description": "Explicit public query keys only. Credential/OAuth keys are rejected by runtime validation."
            }
          },
          "selectors": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
              "not": {
                "enum": [
                  "constructor",
                  "prototype"
                ]
              }
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "selector",
                "read"
              ],
              "properties": {
                "selector": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024,
                  "description": "Validated public CSS grammar. No escapes, secret attribute predicates, or stateful pseudos. >>> crosses an open shadow root."
                },
                "read": {
                  "enum": [
                    "text",
                    "attribute",
                    "json"
                  ]
                },
                "all": {
                  "type": "boolean",
                  "default": false
                },
                "attribute": {
                  "enum": [
                    "title",
                    "alt",
                    "aria-label",
                    "href",
                    "src",
                    "poster",
                    "content",
                    "datetime"
                  ]
                },
                "path": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "maxLength": 100,
                    "pattern": "^(?:[A-Za-z_][A-Za-z0-9_-]*|[0-9]+)$",
                    "description": "Own-property keys only. Credential and prototype keys are rejected by the runtime."
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "read": {
                        "const": "attribute"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "attribute"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "attribute"
                      ]
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "read": {
                        "const": "json"
                      }
                    }
                  },
                  "then": {
                    "required": [
                      "path"
                    ]
                  },
                  "else": {
                    "not": {
                      "required": [
                        "path"
                      ]
                    }
                  }
                }
              ]
            }
          },
          "mediaScopes": {
            "type": "object",
            "maxProperties": 4,
            "propertyNames": {
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
              "not": {
                "enum": [
                  "constructor",
                  "prototype"
                ]
              }
            },
            "description": "Bounded single-player ancestor containers. Requires media: true; all captures share the page read limits.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "container",
                "ancestors",
                "selectors"
              ],
              "properties": {
                "container": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "ancestors": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16
                },
                "exclude": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "selectors": {
                  "type": "object",
                  "maxProperties": 32,
                  "propertyNames": {
                    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
                    "not": {
                      "enum": [
                        "constructor",
                        "prototype"
                      ]
                    }
                  },
                  "additionalProperties": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "selector",
                      "read"
                    ],
                    "properties": {
                      "selector": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1024,
                        "description": "Validated public CSS grammar. No escapes, secret attribute predicates, or stateful pseudos. >>> crosses an open shadow root."
                      },
                      "read": {
                        "enum": [
                          "text",
                          "attribute"
                        ]
                      },
                      "all": {
                        "type": "boolean",
                        "default": false
                      },
                      "attribute": {
                        "enum": [
                          "title",
                          "alt",
                          "aria-label",
                          "href",
                          "src",
                          "poster",
                          "content",
                          "datetime"
                        ]
                      },
                      "path": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 12,
                        "items": {
                          "type": "string",
                          "maxLength": 100,
                          "pattern": "^(?:[A-Za-z_][A-Za-z0-9_-]*|[0-9]+)$",
                          "description": "Own-property keys only. Credential and prototype keys are rejected by the runtime."
                        }
                      }
                    },
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "read": {
                              "const": "attribute"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "attribute"
                          ]
                        },
                        "else": {
                          "not": {
                            "required": [
                              "attribute"
                            ]
                          }
                        }
                      },
                      {
                        "if": {
                          "properties": {
                            "read": {
                              "const": "json"
                            }
                          }
                        },
                        "then": {
                          "required": [
                            "path"
                          ]
                        },
                        "else": {
                          "not": {
                            "required": [
                              "path"
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "mediaScopes"
              ]
            },
            "then": {
              "required": [
                "media"
              ],
              "properties": {
                "media": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    }
  },
  "reportSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://chudpresence.local/schemas/activity-v2-report.schema.json",
    "title": "ChudPresence Activity API v2 Report",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "kind",
      "media"
    ],
    "properties": {
      "kind": {
        "enum": [
          "video",
          "movie",
          "episode",
          "song",
          "stream",
          "game",
          "generic"
        ]
      },
      "media": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "subtitle": {
            "$ref": "#/$defs/text"
          },
          "artist": {
            "$ref": "#/$defs/text"
          },
          "album": {
            "$ref": "#/$defs/text"
          },
          "series": {
            "$ref": "#/$defs/text"
          },
          "season": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "episode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "creator": {
            "$ref": "#/$defs/text"
          },
          "channel": {
            "$ref": "#/$defs/text"
          },
          "category": {
            "$ref": "#/$defs/text"
          },
          "game": {
            "$ref": "#/$defs/text"
          },
          "playlist": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "playback": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "state": {
            "enum": [
              "playing",
              "paused",
              "stopped"
            ]
          },
          "position": {
            "type": "number",
            "minimum": 0,
            "maximum": 31536000
          },
          "duration": {
            "type": "number",
            "minimum": 0,
            "maximum": 31536000
          },
          "live": {
            "type": "boolean"
          },
          "rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 16
          },
          "elapsed": {
            "type": "boolean",
            "description": "Elapsed time for a generic page activity, without a Live label."
          }
        }
      },
      "display": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "details": {
            "$ref": "#/$defs/text"
          },
          "detailsUrl": {
            "$ref": "#/$defs/httpsUrl"
          },
          "state": {
            "$ref": "#/$defs/text"
          },
          "stateUrl": {
            "$ref": "#/$defs/httpsUrl"
          },
          "statusDisplay": {
            "enum": [
              "name",
              "details",
              "state"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          }
        }
      },
      "artwork": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "large": {
            "$ref": "#/$defs/httpsUrl"
          },
          "largeUrl": {
            "$ref": "#/$defs/httpsUrl"
          },
          "largeText": {
            "$ref": "#/$defs/text"
          },
          "small": {
            "$ref": "#/$defs/httpsUrl"
          },
          "smallText": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "buttons": {
        "type": "array",
        "maxItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "url"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "\\S"
            },
            "url": {
              "$ref": "#/$defs/httpsUrl"
            }
          }
        }
      },
      "visibility": {
        "enum": [
          "normal",
          "idle",
          "private",
          "ad"
        ]
      }
    },
    "$defs": {
      "text": {
        "type": "string",
        "maxLength": 256
      },
      "httpsUrl": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048,
        "pattern": "^https://"
      }
    },
    "allOf": [
      {
        "if": {
          "required": [
            "playback"
          ],
          "properties": {
            "playback": {
              "required": [
                "elapsed"
              ],
              "properties": {
                "elapsed": {
                  "const": true
                }
              }
            }
          }
        },
        "then": {
          "properties": {
            "kind": {
              "const": "generic"
            },
            "playback": {
              "properties": {
                "live": {
                  "const": false
                },
                "duration": {
                  "const": 0
                }
              }
            }
          }
        }
      }
    ]
  }
}
