{
  "schemaVersion": 1,
  "id": "tmdb-movie",
  "name": "TMDB movie artwork",
  "description": "Send an approved visible movie title to TMDB movie search and use its first result's public poster path as artwork.",
  "endpoint": "https://api.themoviedb.org/3/search/movie",
  "parameters": {
    "query": { "type": "text", "maxLength": 256 }
  },
  "staticQuery": {
    "include_adult": "false",
    "language": "en-US"
  },
  "outputs": {
    "artwork.large": {
      "path": ["results", 0, "poster_path"],
      "type": "image-path",
      "baseUrl": "https://image.tmdb.org/t/p/w500"
    },
    "artwork.largeText": {
      "path": ["results", 0, "title"],
      "type": "text"
    }
  },
  "auth": "bearer"
}
