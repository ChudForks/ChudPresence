{
  "id": "instagram",
  "name": "Instagram",
  "description": "Show the active Instagram reel caption, creator, native video progress, static app logo and clean reel/profile buttons using reusable V2 capabilities.",
  "version": "1.1.0",
  "apiVersion": 2,
  "minExtensionVersion": "2.3.0",
  "author": {
    "name": "ChudPresence"
  },
  "category": "video",
  "defaultMediaKind": "video",
  "tags": [
    "reels",
    "social",
    "video"
  ],
  "serviceUrl": "https://www.instagram.com/",
  "matches": [
    "https://www.instagram.com/reels*",
    "https://instagram.com/reels*",
    "https://www.instagram.com/reel/*",
    "https://instagram.com/reel/*"
  ],
  "excludeMatches": [
    "https://www.instagram.com/direct/*",
    "https://instagram.com/direct/*",
    "https://www.instagram.com/accounts/*",
    "https://instagram.com/accounts/*"
  ],
  "entry": "activity.json",
  "icon": "icon.png",
  "settingsUi": {
    "statusLabels": {
      "app": "Instagram",
      "artist": "Creator",
      "track": "Reel"
    }
  }
}
