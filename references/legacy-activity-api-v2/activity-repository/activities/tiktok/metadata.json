{
  "id": "tiktok",
  "name": "TikTok",
  "description": "Show TikTok video descriptions or Watching Live on the first line, the creator on the second, progress or LIVE session timing, the app icon and public video/profile buttons.",
  "version": "1.1.1",
  "apiVersion": 2,
  "minExtensionVersion": "2.2.1",
  "author": {
    "name": "ChudPresence"
  },
  "category": "video",
  "defaultMediaKind": "video",
  "tags": [
    "shorts",
    "social",
    "video",
    "live"
  ],
  "serviceUrl": "https://www.tiktok.com/",
  "matches": [
    "https://www.tiktok.com/*",
    "https://tiktok.com/*"
  ],
  "excludeMatches": [
    "https://www.tiktok.com/messages*",
    "https://tiktok.com/messages*",
    "https://www.tiktok.com/setting*",
    "https://tiktok.com/setting*",
    "https://www.tiktok.com/upload*",
    "https://tiktok.com/upload*"
  ],
  "entry": "activity.json",
  "icon": "icon.png",
  "settingsUi": {
    "statusLabels": {
      "app": "TikTok",
      "artist": "Creator",
      "track": "Video / LIVE status"
    }
  }
}
