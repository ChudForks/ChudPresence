{
  "schemaVersion": 2,
  "kind": "video",
  "scope": "[data-e2e=\"recommend-list-item-container\"]",
  "paths": [
    "/",
    "/foryou",
    "/foryou/",
    "/following",
    "/following/",
    "/{locale}",
    "/{locale}/",
    "/{handle}/video/{number}",
    "/{handle}/video/{number}/"
  ],
  "fields": {
    "title": {
      "source": "dom.text",
      "selectors": [
        "[data-e2e=\"video-desc\"]",
        "[data-e2e=\"browse-video-desc\"]"
      ],
      "ignoreEmptyBreaks": true
    },
    "creator": {
      "source": "first",
      "rules": [
        {
          "source": "dom.text",
          "selectors": [
            "[data-e2e=\"video-author-nickname\"]",
            "[class*=\"DivCreatorInfoContainer\"] a p",
            "[data-e2e=\"user-profile-nickname\"]"
          ]
        },
        {
          "source": "dom.text",
          "selectors": [
            "[data-e2e=\"browser-nickname\"] [class*=\"SpanNickName\"]",
            "[data-e2e=\"browser-nickname\"] [class*=\"SpanEllipsis\"]"
          ]
        },
        {
          "source": "dom.text",
          "selectors": [
            "[data-e2e=\"browser-nickname\"]"
          ],
          "split": {
            "separator": " · ",
            "index": 0
          }
        }
      ]
    },
    "channel": {
      "source": "first",
      "rules": [
        {
          "source": "dom.text",
          "selectors": [
            "[data-e2e=\"video-author-uniqueid\"]",
            "[data-e2e=\"browse-username\"]",
            "[data-e2e=\"user-profile-uid\"]"
          ],
          "parse": "handle"
        },
        {
          "source": "public-path",
          "selectors": [
            "[class*=\"DivCreatorInfoContainer\"] a"
          ],
          "paths": [
            "/{handle}",
            "/{handle}/",
            "/{handle}/live",
            "/{handle}/live/",
            "/{handle}/video/{number}",
            "/{handle}/video/{number}/"
          ],
          "segment": 0,
          "pageFallback": true
        }
      ]
    }
  },
  "requiredFields": [
    "creator",
    "channel"
  ],
  "player": {
    "adapter": "html-media",
    "selectors": [
      "video"
    ],
    "selection": "largest-visible",
    "canvasSelector": "tt-vod-sr-wrap > canvas",
    "canvasContainer": ".tiktok-web-player",
    "live": false
  },
  "pageIdentity": {
    "paths": [
      "/{handle}/video/{number}",
      "/{handle}/video/{number}/"
    ],
    "fields": {
      "channel": 0
    },
    "ignoreCase": true
  },
  "links": {
    "media": {
      "paths": [
        "/{handle}/video/{number}"
      ],
      "matchFields": {
        "channel": 0
      },
      "sources": [
        {
          "source": "page"
        },
        {
          "source": "dom.link",
          "selectors": [
            "a"
          ]
        },
        {
          "source": "template",
          "path": "/{channel}/video/{id}",
          "playerId": {
            "selector": ".tiktok-web-player",
            "split": {
              "separator": "-",
              "index": 2
            },
            "prefixes": [
              "xgwrapper-",
              "video-player-"
            ],
            "parts": 3
          }
        }
      ]
    },
    "profile": {
      "paths": [
        "/{handle}"
      ],
      "matchFields": {
        "channel": 0
      },
      "sources": [
        {
          "source": "template",
          "path": "/{channel}"
        }
      ]
    }
  },
  "presentation": {
    "details": "{title}",
    "state": "{creator} ({channel})",
    "artwork": {
      "large": "https://play-lh.googleusercontent.com/2o7iuqPe-0msP3DvNhzoOgNo4eZ6GkL_RtGVeKyBn5UBQAW5cw-GW5V3wDOHB1yTQuqWzrFLFOv2u4_5ea1uhg=s512",
      "largeText": "TikTok"
    },
    "buttons": [
      {
        "label": "View TikTok",
        "link": "media"
      },
      {
        "label": "View Profile",
        "link": "profile"
      }
    ]
  },
