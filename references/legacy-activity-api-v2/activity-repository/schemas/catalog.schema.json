{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ChudForks/ChudPresence-Activities-V2/blob/main/schemas/catalog.schema.json",
  "title": "ChudPresence Declarative Activity V2 Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "activities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "version",
          "apiVersion",
          "matches",
          "entry",
          "metadata",
          "sha256",
          "metadataSha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
          },
          "apiVersion": {
            "const": 2
          },
          "minExtensionVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
          },
          "author": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            }
          },
          "contributors": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "url": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://"
                }
              }
            }
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          },
          "defaultMediaKind": {
            "enum": [
              "video",
              "movie",
              "episode",
              "song",
              "stream",
              "game",
              "generic"
            ]
          },
          "aliases": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "tags": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
            }
          },
          "matches": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^https://[^/]+/.+$",
              "description": "Exact public HTTPS hosts only; the runtime validator also rejects wildcards, protected hosts and local/IP hosts."
            }
          },
          "excludeMatches": {
            "type": "array",
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 256,
              "pattern": "^https://[^/]+/.+$"
            }
          },
          "entry": {
            "type": "string",
            "pattern": "^activities/[a-z0-9][a-z0-9-]{1,63}/activity\\.json$"
          },
          "icon": {
            "type": "string",
            "pattern": "^activities/[a-z0-9][a-z0-9-]{1,63}/icon\\.png$"
          },
          "frames": {
            "const": "top"
          },
          "settingsUi": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "statusLabels": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "app": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "\\S"
                  },
                  "artist": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "\\S"
                  },
                  "track": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80,
                    "pattern": "\\S"
                  }
                }
              }
            }
          },
          "repository": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "homepage": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "serviceUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "metadata": {
            "type": "string",
            "pattern": "^activities/[a-z0-9][a-z0-9-]{1,63}/metadata\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "metadataSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "iconSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "dependentRequired": {
          "icon": [
            "iconSha256"
          ],
          "iconSha256": [
            "icon"
          ]
        }
      }
    }
  }
}
